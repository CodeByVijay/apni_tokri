
# Veggie Tokri — basic hardening

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sitemap and robots (prefer generated physical XML when present; PHP endpoint remains fallback)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^sitemap-([0-9]+)\.xml$ sitemap.php?part=$1 [L,QSA]
    RewriteRule ^robots\.txt$ robots.php [L]

    # Block direct web access to sensitive directories
    RewriteRule ^includes/ - [F,L,NC]
    RewriteRule ^storage/ - [F,L,NC]
    RewriteRule ^database/ - [F,L,NC]
    RewriteRule ^scripts(/|$) - [F,L,NC]
    RewriteRule ^docs(/|$) - [F,L,NC]

    # Root-level debug/preview scratch files (e.g. _dbg_footer.php) must never be web-reachable.
    RewriteRule ^_ - [F,L,NC]

    # Homepage canonical root (never strip index.php to /index).
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^index\.php$ ./ [R=301,L,QSA,NE]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^index/?$ ./ [R=301,L,QSA,NE]

    # Redirect direct .php requests to extensionless URLs (GET/HEAD only).
    # POST must not redirect — clients often re-issue as GET and break CSRF/AJAX/logout.
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
    RewriteCond %1 !^index$
    RewriteCond %1 !^.*/index$
    RewriteRule ^(.+?)\.php$ /$1 [R=302,L,NE]

    # Delivery settings: real directory admin/settings/delivery/ otherwise maps here with no index;
    # send the extensionless path to the PHP entry so directory listing is not required.
    RewriteRule ^admin/settings/delivery/?$ admin/settings/delivery.php [END]

    # Internally rewrite extensionless URLs to existing PHP files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END]

</IfModule>

# Internal documentation and VCS/backup artifacts are never web assets.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(md|markdown|sql|sqlite|db|bak|backup|log|ini|dist|orig|sh)$">
        Require all denied
    </FilesMatch>
    # Dotfiles (deploy metadata, env, VCS) — /.well-known/ files are unaffected
    # because the match is on the filename, not the directory.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(md|markdown|sql|sqlite|db|bak|backup|log|ini|dist|orig|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Disable directory listing
Options -Indexes

# Long-lived cache for built CSS/JS only (URLs carry ?v=). Upload/catalogue images live under /uploads/ with separate rules.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
